# Local / production environment
# Copy to `.env` (never commit `.env`)

# Postgres — required for uploads, accounts, folders, and show-page CMS
DATABASE_URL=postgres://user:password@host:5432/vidshare
# Set to false for local Docker Postgres (no TLS). Hosted Supabase can omit this.
DATABASE_SSL=

# Public site origin (no trailing slash). Used for setup links and OG tags.
PUBLIC_ORIGIN=https://vidshare.link

# CORS for editor write APIs. Set to the same origin in production.
ALLOWED_ORIGIN=https://vidshare.link

# Magic-code email (Resend)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=VidShare <login@vidshare.link>

# Admin dashboard (`/admin`)
ADMIN_TOKEN=

# Seussical page footer Login (page editor password)
SEUSSICAL_EDITOR_TOKEN=

# Bunny Stream — show-page editors upload videos straight to this library
# (Stream > your library > API for the id + key; the pull zone hostname is
# under Stream > your library > Player / Embed, e.g. vz-abc123-def.b-cdn.net)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# Optional: persist the session HMAC across fresh databases (otherwise
# the server stores one in vs_meta on first boot)
SESSION_SECRET=

# Optional: Supabase extras used by some page-image uploads
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional
JWT_SECRET=
WISTIA_API_PASSWORD=
ALLOW_ANONYMOUS_UPLOADS=false
COOKIE_SECURE=true
PORT=5000
NODE_ENV=production
