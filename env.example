# Local / production environment
# Copy to `.env` (never commit `.env`)

# Postgres — required for uploads, accounts, folders, and show-page CMS
DATABASE_URL=postgres://user:password@host:5432/vidshare
# Set to false for local Docker Postgres (no TLS). Hosted Supabase can omit this.
DATABASE_SSL=

# Public site origin (no trailing slash). Used for setup links and OG tags.
PUBLIC_ORIGIN=https://your.domain

# CORS for editor write APIs. Set to the same origin in production.
ALLOWED_ORIGIN=https://your.domain

# Magic-code email (Resend)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=VidShare <login@your.domain>

# Admin dashboard (`/admin`)
ADMIN_TOKEN=

# Optional: persist the session HMAC across fresh databases (otherwise
# the server stores one in vs_meta on first boot)
SESSION_SECRET=

# Optional: Supabase extras used by some page-image uploads
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional
JWT_SECRET=
WISTIA_API_PASSWORD=
ALLOW_ANONYMOUS_UPLOADS=false
COOKIE_SECURE=true
PORT=5000
NODE_ENV=production
