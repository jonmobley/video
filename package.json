{
  "name": "vidshare-dance-hub",
  "version": "1.0.0",
  "description": "Dance instruction video sharing platform for theater groups",
  "homepage": "https://vidshare.co",
  "main": "index.html",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "echo 'No build step required'",
    "deploy": "npx wrangler deploy",
    "test": "jest",
    "test:e2e": "npx playwright test",
    "test:watch": "jest --watch",
    "lint": "eslint handlers js",
    "lint:fix": "eslint handlers js --fix"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/jest/helpers/env.js"
    ],
    "testMatch": [
      "<rootDir>/tests/jest/**/*.test.js"
    ]
  },
  "keywords": [
    "dance",
    "theater",
    "video",
    "cloudflare"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Theater Group",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.56.1",
    "archiver": "^7.0.1",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.20.0",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@playwright/test": "^1.59.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "supertest": "^7.2.2",
    "wrangler": "^4.129.0"
  }
}
