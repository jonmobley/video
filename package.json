{
  "name": "vidshare-dance-hub",
  "version": "1.0.0",
  "description": "Dance instruction video sharing platform for theater groups",
  "main": "index.html",
  "scripts": {
    "dev": "netlify dev",
    "build": "echo 'No build step required'",
    "deploy": "netlify deploy --prod",
    "test": "jest",
    "test:e2e": "npx playwright test",
    "test:watch": "jest --watch",
    "lint": "eslint netlify/functions js",
    "lint:fix": "eslint netlify/functions js --fix"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/jest/**/*.test.js"
    ]
  },
  "keywords": [
    "dance",
    "theater",
    "video",
    "wistia",
    "netlify"
  ],
  "author": "Theater Group",
  "license": "MIT",
  "dependencies": {
    "@netlify/blobs": "^10.0.10",
    "@supabase/supabase-js": "^2.56.1",
    "archiver": "^7.0.1",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.20.0",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "netlify-cli": "^17.0.0",
    "supertest": "^7.2.2"
  }
}
