{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vidshare",
  "main": "workers/origin.js",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  // Production hostname. Requires vidshare.co as an active Cloudflare zone
  // (move nameservers off Netlify/NS1 first — see HOSTING.md).
  "vars": {
    "PUBLIC_ORIGIN": "https://vidshare.co",
    "ALLOWED_ORIGIN": "https://vidshare.co"
  },
  "routes": [
    { "pattern": "vidshare.co", "custom_domain": true },
    { "pattern": "www.vidshare.co", "custom_domain": true }
  ],
  "containers": [
    {
      "class_name": "VidShare",
      "image": "./Dockerfile",
      // Node + Postgres driver + in-memory finalize of uploaded video.
      // lite (256 MiB) OOMs; bump to standard-1+ if native uploads exceed ~500 MB.
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "VidShare",
        "name": "VIDSHARE"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VidShare"]
    }
  ]
}
