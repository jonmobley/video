{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vidshare",
  "main": "workers/origin.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "routes": [
    { "pattern": "vidshare.link", "custom_domain": true },
    { "pattern": "www.vidshare.link", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "VidShare",
      "image": "./Dockerfile",
      // Node + Postgres driver. Uploads stay as ordered chunks (no in-memory
      // assemble-at-finalize). basic is enough for typical dance videos.
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "VidShare",
        "name": "VIDSHARE"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VidShare"]
    }
  ]
}
